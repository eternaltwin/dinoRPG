{
  "compilerOptions": {
    "composite": true,
    "target": "esnext",
    "module": "NodeNext",
    "strict": true,
    "jsx": "preserve",
    "importHelpers": true,
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "declaration": true,
    "outDir": "./dist/ts",
    "noImplicitAny": false,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable",
      "scripthost"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "**/i18n/locales/*.json",
  ],
  "exclude": [],
  "references": [
    {
      "path": "./tsconfig.deps.json"
    },
    {
      "path": "../core"
    },
    {
      "path": "../prisma"
    }
  ]
}
