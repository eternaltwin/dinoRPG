{
  "name": "ed-ui",
  "version": "0.9.2",
  "private": true,
  "scripts": {
    "serve": "concurrently -k -n \"vite,deps\" -p \"[{name}]\" \"yarn run serve:app\" \"yarn run serve:deps\"",
    "serve:app": "yarn run build:deps && yarn run lint:fix && vite --host",
    "serve:deps": "yarn run build:deps --watch",
    "build": "yarn run build:deps && vite build",
    "build:deps": "tsc --project ./tsconfig.deps.json --noEmit",
    "preview": "vite preview",
    "lint:test": "eslint --ext .ts,vue --ignore-path .gitignore .",
    "lint:fix": "eslint --ext .ts,vue --ignore-path .gitignore . --fix"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.0",
    "url-join": "^5.0.0",
    "vue": "^3.3.8",
    "vue-i18n": "^9.6.5",
    "vue-router": "^4.2.5",
    "vue-tippy": "^6.3.1"
  },
  "devDependencies": {
    "@drpg/core": "workspace:^",
    "@types/url-join": "^4.0.2",
    "@types/vue-i18n": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.36.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.18.1",
    "file-loader": "^6.2.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.0.3",
    "sass": "^1.60.0",
    "typescript": "^5.2.2",
    "vite": "^4.5.0"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "type": "module",
  "imports": {
    "#assets": "./src/assets/*"
  }
}
