{
  "name": "ed-ui",
  "version": "0.15.15",
  "private": true,
  "scripts": {
    "serve": "yarn concurrently -k -n \"vite,deps\" -p \"[{name}]\" \"yarn run serve:app\" \"yarn run serve:deps\"",
    "serve:app": "yarn run build:deps && yarn run lint:fix && yarn vite --host",
    "serve:deps": "yarn run build:deps --watch",
    "build": "NODE_OPTIONS=\"--max_old_space_size=8192\" && yarn run build:deps && yarn vite build",
    "build:deps": "yarn tsc --project ./tsconfig.deps.json --noEmit",
    "preview": "yarn vite preview",
    "lint:test": "yarn eslint --ext .ts,vue --ignore-path .gitignore .",
    "lint:fix": "yarn eslint --ext .ts,vue --ignore-path .gitignore . --fix",
    "release": "yarn release-it"
  },
  "release-it": {
    "git": false
  },
  "dependencies": {
    "@ckeditor/ckeditor5-build-classic": "^42.0.2",
    "@ckeditor/ckeditor5-vue": "^6.0.0",
    "axios": "^1.6.0",
    "chart.js": "^4.4.2",
    "ckeditor5": "^42.0.2",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.0",
    "pixi.js": "^7.3.2",
    "url-join": "^5.0.0",
    "vue": "^3.3.8",
    "vue-chartjs": "^5.3.1",
    "vue-i18n": "^9.6.5",
    "vue-router": "^4.2.5",
    "vue-tippy": "^6.3.1",
    "vue-toast-notification": "^3"
  },
  "devDependencies": {
    "@drpg/core": "workspace:^",
    "@drpg/dino-animation": "workspace:^",
    "@types/url-join": "^4.0.3",
    "@types/vue-i18n": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "@vitejs/plugin-vue": "^4.4.0",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.36.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-vue": "^9.18.1",
    "file-loader": "^6.2.0",
    "lint-staged": "^15.0.2",
    "prettier": "^3.4.2",
    "sass": "^1.60.0",
    "twinoid-goals": "^1.2.2",
    "typescript": "^5.7.2",
    "vite": "^4.5.0",
    "vite-plugin-mkcert": "^1.17.6",
    "vite-plugin-vue-devtools": "^7.4.6"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "type": "module",
  "imports": {
    "#assets": "./src/assets/*"
  }
}
