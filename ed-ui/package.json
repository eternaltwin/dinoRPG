{
  "name": "ed-ui",
  "version": "0.7.0",
  "private": true,
  "scripts": {
    "serve": "concurrently -k -n \"vite,deps\" -p \"[{name}]\" \"yarn run serve:app\" \"yarn run serve:deps\"",
    "serve:app": "yarn run build:deps && yarn run lint:fix && vite --host",
    "serve:deps": "yarn run build:deps --watch",
    "build": "yarn run build:deps && vite build",
    "build:deps": "tsc --project ./tsconfig.deps.json --noEmit",
    "preview": "vite preview",
    "lint:test": "eslint --ext .ts,vue --ignore-path .gitignore .",
    "lint:fix": "eslint --ext .ts,vue --ignore-path .gitignore . --fix"
  },
  "dependencies": {
    "@rollup/plugin-typescript": "^11.1.2",
    "@vitejs/plugin-vue": "^4.2.3",
    "axios": "^1.3.4",
    "mitt": "^3.0.0",
    "pinia": "^2.0.33",
    "pinia-plugin-persistedstate": "^3.1.0",
    "url-join": "^5.0.0",
    "vite": "^4.4.4",
    "vue": "^3.2.47",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.1.6",
    "vue-tippy": "^6.0.0"
  },
  "devDependencies": {
    "@drpg/core": "workspace:^",
    "@types/url-join": "^4.0.1",
    "@types/vue-i18n": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "concurrently": "^7.6.0",
    "eslint": "^8.36.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.10.0",
    "file-loader": "^6.2.0",
    "lint-staged": "^13.2.0",
    "prettier": "^2.8.7",
    "sass": "^1.60.0",
    "typescript": "^4.9.5"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "type": "module",
  "imports": {
    "#assets": "./src/assets/*"
  }
}
