{
  "name": "ed-ui",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "serve": "yarn run lint:fix && vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint:test": "eslint --ext .ts,vue --ignore-path .gitignore .",
    "lint:fix": "eslint --ext .ts,vue --ignore-path .gitignore . --fix"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "mitt": "^3.0.0",
    "pinia": "^2.0.14",
    "pinia-plugin-persistedstate": "^2.1.1",
    "url-join": "^5.0.0",
    "vue": "^3.2.37",
    "vue-i18n": "^9.1.10",
    "vue-router": "^4.0.16",
    "vue-tippy": "6.0.0-alpha.43",
    "webpack": "^5.73.0"
  },
  "devDependencies": {
    "@types/url-join": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^5.35.1",
    "@typescript-eslint/parser": "^5.35.1",
    "@vitejs/plugin-vue": "^3.0.3",
    "@vue/cli-plugin-typescript": "~5.0.6",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "eslint": "^8.19.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.1.1",
    "file-loader": "^6.2.0",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "sass": "^1.53.0",
    "typescript": "^4.7.4",
    "vite": "^3.0.9"
  },
  "gitHooks": {
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "vue-cli-service lint",
      "git add"
    ]
  },
  "packageManager": "yarn@3.2.3"
}
