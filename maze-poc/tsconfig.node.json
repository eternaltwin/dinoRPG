{
	"//": "Standalone build for the pure-logic Node test (no DOM / no Pixi). Emits CommonJS so plain `node` can run it.",
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "Node",
		"lib": ["ES2020"],
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"outDir": "dist-test",
		"rootDir": "."
	},
	"include": ["src/dungeon", "test"]
}
