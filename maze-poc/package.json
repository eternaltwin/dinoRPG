{
	"name": "@eternaltwin/dinorpg-maze-poc",
	"private": true,
	"version": "0.0.0",
	"description": "POC: DinoRPG dungeon/maze generation + codec (ported from the Haxe archive) rendered with Pixi.js, dinoz animated via @eternaltwin/dinorpg_animations",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"test": "tsc -p tsconfig.node.json && node -e \"require('fs').writeFileSync('dist-test/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node dist-test/test/codec.test.js"
	},
	"dependencies": {
		"@eternaltwin/dinorpg_animations": "^1.0.9",
		"pixi.js": "^7.4.3"
	},
	"devDependencies": {
		"typescript": "^5.7.2",
		"vite": "^4.5.0"
	}
}
