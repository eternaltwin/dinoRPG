{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "Node16",
    "target": "es2021",
    "lib": [
      "es2021"
    ],
    "moduleResolution": "Node16",
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false
  }
}
