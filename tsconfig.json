{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "esnext",
    "esModuleInterop": true,
    "target": "esnext",
    "lib": ["ESNext"],
    "moduleResolution": "Node16",
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "composite": true,
    "useUnknownInCatchVariables": false
  }
}
