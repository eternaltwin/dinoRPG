{
  "name": "@eternaltwin/dinorpg-monorepo",
  "private": true,
  "licenses": [
    {
      "type": "AGPL-3.0-or-later",
      "url": "https://spdx.org/licenses/AGPL-3.0-or-later.html"
    }
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start:back": "cd ed-be && yarn run serve",
    "start:front": "cd ed-ui && yarn run serve",
    "serve": "concurrently -k -n \"back,front\" -p \"[{name}]\" -c \"blue,green,orange\" \"yarn run start:back\" \"yarn run start:front\"",
    "build:back": "cd ed-be && yarn run build",
    "build:front": "cd ed-ui && yarn run build",
    "build:native": "cd native && yarn run build",
    "build:native-debug": "cd native && yarn run build-debug",
    "build:ci": "cd native && yarn run build:ci",
    "build:gitlab": "yarn run build:ci && yarn run build:back && yarn run build:front",
    "build": "yarn run build:native && yarn run build:back && yarn run build:front",
    "build-debug": "yarn run build:native-debug && yarn run build:back && yarn run build:front",
    "etwin": "cd Eternaltwin && yarn run etwin db upgrade",
    "test:ci": "cd ed-be && yarn run test:ci",
    "coverage": "cd ed-be && yarn run coverage",
    "lint:test": "cd ed-ui && yarn lint:test",
    "lint:fix": "cd ed-ui && yarn lint:fix",
    "prettier": "prettier --config .prettierrc '**/src/**/*.{mts,ts,json}' --write && yarn lint:fix",
    "precommit": "yarn prettier",
    "clean": "rimraf -g ed-ui/ts-out ed-ui/.rollup.cache ed-be/dist core/dist ./node_modules '*/tsconfig.tsbuildinfo' ./.yarn/cache ./.yarn/install",
    "reset": "yarn clean && yarn install && cd Eternaltwin && yarn install",
    "etwin:run": "cd Eternaltwin && yarn run etwin",
    "dev:windows": "concurrently -k -n \"back,front,etwin\" -p \"[{name}]\" -c \"blue,green,orange\" \"yarn run start:back\" \"yarn run start:front\" \"yarn run etwin:run\"",
    "db:sync:dev": "cd ed-be && yarn db:sync:dev",
    "db:migrate:manual": "cd ed-be && yarn db:migrate:manual",
    "migration": "cd ed-be && yarn migration"
  },
  "workspaces": {
    "packages": [
      "ed-be/",
      "native/",
      "ed-ui/",
      "core/",
      "prisma/",
      "Eternaltwin/",
      "dinoAnimation/"
    ]
  },
  "packageManager": "yarn@4.1.0",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "husky": "^8.0.3",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "typescript": "^5.2.2"
  }
}
