{
	"name": "@eternaltwin/dinorpg-monorepo",
	"private": true,
	"version": "0.18.6",
	"licenses": [
		{
			"type": "AGPL-3.0-or-later",
			"url": "https://spdx.org/licenses/AGPL-3.0-or-later.html"
		}
	],
	"engines": {
		"node": ">=22"
	},
	"release-it": {
		"git": {
			"requireCleanWorkingDir": false,
			"commitMessage": "version: ${version}",
			"tagAnnotation": "Release ${version}",
			"tagName": "${version}"
		},
		"npm": {
			"publish": false
		},
		"hooks": {
			"after:bump": "yarn run update-version"
		},
		"plugins": {
			"@release-it/bumper": {
				"in": [
					"package.json"
				],
				"out": [
					"ed-be/package.json",
					"ed-ui/package.json",
					"core/package.json",
					"prisma/package.json",
					"Eternaltwin/package.json"
				]
			}
		}
	},
	"scripts": {
		"release": "yarn release-it",
		"start:back": "cd ed-be && yarn run serve",
		"start:front": "cd ed-ui && yarn run serve",
		"serve": "concurrently -k -n \"back,front\" -p \"[{name}]\" -c \"blue,green,orange\" \"yarn run start:back\" \"yarn run start:front\"",
		"build:back": "cd ed-be && yarn run build",
		"build:front": "cd ed-ui && yarn run build",
		"build:render": "cd dino-renderer && yarn run build",
		"build:gitlab": "yarn run build:render && yarn run build:back && yarn run build:front",
		"build": "yarn run build:render && yarn run build:back && yarn run build:front",
		"build-debug": "yarn run build:back && yarn run build:front",
		"etwin": "cd Eternaltwin && yarn run eternaltwin db sync",
		"test:ci": "cd ed-be && yarn run test:ci",
		"coverage": "cd ed-be && yarn run coverage",
		"lint:test": "cd ed-ui && yarn lint:test",
		"lint:fix": "cd ed-ui && yarn lint:fix",
		"lint": "yarn prettier --config .prettierrc '**/src/**/*.{mts,ts,json}' --write && yarn lint:fix",
		"precommit": "yarn prettier",
		"clean": "yarn rimraf -g ed-ui/ts-out ed-ui/.rollup.cache ed-be/dist core/dist ./node_modules '*/tsconfig.tsbuildinfo' ./.yarn/cache ./.yarn/install ed-ui/node_modules ed-be/node_modules Eternaltwin/node_modules",
		"reset": "yarn clean && yarn install && cd Eternaltwin && yarn install",
		"etwin:run": "cd Eternaltwin && yarn run eternaltwin start",
		"dev:windows": "yarn concurrently -k -n \"back,front,etwin\" -p \"[{name}]\" -c \"blue,green,orange\" \"yarn run start:back\" \"yarn run start:front\" \"yarn run etwin:run\"",
		"db:sync:dev": "cd ed-be && yarn db:sync:dev",
		"db:migrate:manual": "cd ed-be && yarn db:migrate:manual",
		"migration": "cd ed-be && yarn migration",
		"update-version": "node scripts/update-version.js"
	},
	"workspaces": {
		"packages": [
			"ed-be/",
			"ed-ui/",
			"core/",
			"prisma/",
			"Eternaltwin/",
			"dino-renderer/"
		]
	},
	"packageManager": "yarn@4.10.3",
	"devDependencies": {
		"@release-it/bumper": "^7.0.5",
		"concurrently": "^9.1.0",
		"husky": "^8.0.3",
		"prettier": "^3.4.2",
		"release-it": "^17.6.0",
		"rimraf": "^5.0.5",
		"typescript": "^5.7.2"
	}
}
