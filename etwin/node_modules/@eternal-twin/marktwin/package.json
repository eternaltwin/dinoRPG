{
  "name": "@eternal-twin/marktwin",
  "version": "0.2.0",
  "homepage": "https://gitlab.com/eternal-twin/marktwin",
  "description": "Marktwin parser and formatter",
  "repository": {
    "type": "git",
    "url": "git://gitlab.com:eternal-twin/marktwin.git"
  },
  "licenses": [
    {
      "type": "AGPL-3.0-or-later",
      "url": "https://spdx.org/licenses/AGPL-3.0-or-later.html"
    }
  ],
  "private": false,
  "scripts": {
    "build:deps": "yarn --cwd ../marktwin-core build",
    "lint": "eslint \"./src/**/*.ts\"",
    "format": "eslint --fix \"./src/**/*.ts\"",
    "build": "yarn build:deps && tsc --build src/lib/tsconfig.json",
    "pretest": "yarn build:deps && tsc --build src/test/tsconfig.json",
    "test": "mocha --experimental-wasm-modules \"test/**/*.spec.js\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [],
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@eternal-twin/marktwin-core": "^0.2.0"
  },
  "devDependencies": {
    "@types/chai": "^4.2.12",
    "@types/mocha": "^8.0.3",
    "@types/node": "^14.6.3",
    "chai": "^4.2.0",
    "eslint": "^7.8.1",
    "furi": "^2.0.0",
    "mocha": "^8.1.3",
    "typescript": "^4.0.2"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./lib/": "./lib/"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "./lib/"
  ]
}
