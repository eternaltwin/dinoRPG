{
  "name": "@drpg/core",
  "version": "0.15.15",
  "scripts": {
    "build": "yarn tsc --build ./tsconfig.json",
    "prettier": "yarn prettier --config .prettierrc 'src/**/*.mts' --write",
    "release": "yarn release-it"
  },
  "release-it": {
    "git": false
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-ts": "^1.4.0",
    "@types/eslint": "^9.6.1",
    "@types/seedrandom": "^3.0.8",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.11.0",
    "eslint": "^8.0.1",
    "eslint-config-standard-with-typescript": "^40.0.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-promise": "^6.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "type": "module",
  "exports": {
    "./*": "./dist/*.mjs"
  },
  "files": [
    "./dist/**/*.(mjs|map|mts|js|ts)",
    "./src/"
  ],
  "dependencies": {
    "dayjs": "^1.11.10",
    "pure-rand": "^6.1.0",
    "seedrandom": "^3.0.5"
  }
}
