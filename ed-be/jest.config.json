{
  "transform": {"^.+\\.jsx?$": "babel-jest"},
  "moduleFileExtensions": ["js", "ts"],
  "testMatch": ["**/*Test.js"],
  "testEnvironment": "node",
  "collectCoverageFrom": ["src/**/*.js", "!**/node_modules/**"],
  "coverageReporters": ["html", "text", "text-summary", "cobertura"],
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "/models/",
    "/test/",
    "/dao/",
    "/utils/",
    "/constants/"
  ]
}
