{
  "transform": {"^.+\\.jsx?$": "babel-jest"},
  "moduleFileExtensions": ["js", "ts"],
  "testMatch": ["**/*Test.js"],
  "collectCoverageFrom" : ["**/*.js"],
  "testEnvironment": "node",
  "coverageReporters": ["html", "text", "text-summary", "cobertura"],
  "coveragePathIgnorePatterns": [
    "/node_modules/",
    "/models/",
    "/test/",
    "/dao/",
    "/utils/",
    "/constants/",
    "/coverage",
    "/config/",
    "/sequelize.js",
    "/server.js",
    "/routes/",
    "/oauthService.js"
  ]
}
