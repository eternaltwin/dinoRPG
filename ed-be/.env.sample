MAIL_HOST=xxx
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=xxx
MAIL_PASSWORD="xxx"
ETERNALTWIN_CHANNEL="dev"

# SERVER
PORT=8081
WSS_PORT=8082
SELF_URL="http://localhost:8080/"

# DUNGEON — AES-256-GCM key for the maze layout (32 bytes / 64 hex chars).
# "pixy" is the sole holder of this key; without it a stolen DB yields no solvable map.
DUNGEON_KEY=e47098bc77dbc6334cf36f4d03d0d67fceda91a9afeec38ffae4529957675b39

# ETWIN
ETWIN_URL="http://localhost:50320/"
# Used only with raw Eternaltwin and not package
ETERNALTWIN_PUBLIC_URL="http://localhost:4200/"
ETWIN_CLIENT_ID="dinorpg@clients"
ETWIN_CLIENT_SECRET="dev_secret"
# Scope of OAuth, should match allowed_scopes in eternaltwin.toml
ETERNALTWIN_SCOPE="forum:write"
# Section reference: a UUID or a section key. The key works on any instance.
ETERNALTWIN_SECTION="drpg_main"

# ADMIN
ADMIN="eb989f16-94a4-47ab-a4bb-151c3f529fac"

# DISCORD PANTHEON NOTIFICATION
# DISCORD_PANTHEON_WEBHOOK_ID="xxx"
# DISCORD_PANTHEON_WEBHOOK_TOKEN="xxx"

# DISCORD NEWS NOTIFICATION
# DISCORD_NEWS_WEBHOOK_ID="xxx"
# DISCORD_NEWS_WEBHOOK_TOKEN="xxx"

# DISCORD LOGS
# DISCORD_LOGS_WEBHOOK_ID="xxx"
# DISCORD_LOGS_WEBHOOK_TOKEN="xxx"


# This was inserted by `prisma init`:
# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dinorpg?schema=public"
