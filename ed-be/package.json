{
	"name": "ed-be",
	"version": "0.15.10",
	"description": "EternalDino API",
	"scripts": {
		"serve": "yarn tsc-watch --build ./tsconfig.json --onSuccess \"node dist/main.js\"",
		"debug": "yarn concurrently -k -n \"Typescript,Node\" -p \"[{name}]\" -c \"blue,green\" \"tsc --watch\" \"node --inspect dist/server.js\"",
		"lint": "yarn prettier --config .prettierrc 'src/**/*.ts' --write",
		"test:ci": "yarn run build && NODE_ENV=development NODE_OPTIONS=\"--experimental-vm-modules\" yarn jest --config ./jest.config.json --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --watchAll=false",
		"test:debug": "yarn run build && NODE_ENV=development jest --config ./jest.config.json --watchAll",
		"build": "yarn tsc --build ./tsconfig.json",
		"start": "yarn run build && node dist/index.js",
		"db:sync:dev": "yarn prisma migrate dev && cp ../prisma/package.reference.json ../prisma/package.json",
		"db:migrate:manual": "yarn prisma migrate dev --create-only",
		"migration": "yarn prisma migrate deploy",
		"seed": "node --loader ts-node/esm prisma/seed.ts",
		"release": "yarn release-it"
	},
	"release-it": {
		"git": false
	},
	"author": "Jolujolu",
	"license": "ISC",
	"dependencies": {
		"@drpg/core": "workspace:^",
		"@eternaltwin/core": "^0.14.2",
		"@eternaltwin/oauth-client-http": "^0.14.2",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.56.0",
		"@opentelemetry/instrumentation": "^0.56.0",
		"@opentelemetry/instrumentation-express": "^0.46.0",
		"@opentelemetry/instrumentation-http": "^0.56.0",
		"@opentelemetry/resources": "^1.29.0",
		"@opentelemetry/sdk-node": "^0.56.0",
		"@opentelemetry/sdk-trace-node": "^1.29.0",
		"@opentelemetry/semantic-conventions": "^1.28.0",
		"@prisma/client": "^6.0.1",
		"@prisma/instrumentation": "^6.0.1",
		"body-parser": "^1.20.3",
		"cors": "^2.8.5",
		"cron": "^3.3.1",
		"dayjs": "^1.11.10",
		"discord.js": "^14.13.0",
		"dotenv": "^16.4.5",
		"express": "^4.21.2",
		"express-jwt": "^8.5.1",
		"express-validator": "^7.2.0",
		"i18next": "^23.12.2",
		"i18next-fs-backend": "^2.3.1",
		"jsonwebtoken": "^9.0.2",
		"multer": "^1.4.5-lts.1",
		"node-fetch": "^3.3.2",
		"node-schedule": "^2.1.1",
		"reflect-metadata": "^0.1.13",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.0",
		"toml": "^3.0.0",
		"url": "^0.11.3",
		"ws": "^8.15.1"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin-ts": "^1.4.0",
		"@types/cors": "^2.8.17",
		"@types/cron": "^2.4.3",
		"@types/express": "^4.17.21",
		"@types/express-jwt": "^7.4.4",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.10.2",
		"@types/node-fetch": "^2.6.12",
		"@types/node-schedule": "^2.1.7",
		"@types/request": "^2.48.12",
		"@types/sanitize-html": "^2.13.0",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.7",
		"@types/validator": "^13.12.2",
		"@types/ws": "^8.5.13",
		"concurrently": "^9.1.0",
		"prettier": "^3.4.2",
		"prisma": "^6.0.1",
		"sanitize-html": "^2.13.1",
		"ts-node": "^10.9.2",
		"tsc-watch": "6.2.1",
		"typescript": "^5.7.2"
	},
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./*": "./dist/*.js"
	},
	"files": [
		"./dist/**/*.(js|map|ts)",
		"./src/"
	]
}
