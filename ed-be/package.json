{
  "name": "ed-be",
  "version": "1.0.0",
  "description": "EternalDino API",
  "scripts": {
    "serve": "tsc-watch --build ./tsconfig.json --onSuccess \"node dist/server.js\"",
    "debug": "concurrently -k -n \"Typescript,Node\" -p \"[{name}]\" -c \"blue,green\" \"tsc --watch\" \"node --inspect dist/server.js\"",
    "prettier": "prettier --config .prettierrc 'src/**/*.ts' --write",
    "test:ci": "yarn run build && NODE_ENV=development NODE_OPTIONS=\"--experimental-vm-modules\" yarn jest --config ./jest.config.json --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit --watchAll=false",
    "test:debug": "yarn run build && NODE_ENV=development jest --config ./jest.config.json --watchAll",
    "build": "tsc --build ./tsconfig.json",
    "start": "yarn run build && node dist/index.js",
    "typeorm": "typeorm-ts-node-esm",
    "run:migration": "yarn run build && typeorm-ts-node-esm migration:run -d dist/data-source.js",
    "migration:generate": "yarn typeorm migration:generate -d src/data-source.ts src/migration/${0}"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "postgresql",
    "rest",
    "api"
  ],
  "author": "Jolujolu",
  "license": "ISC",
  "dependencies": {
    "@drpg/core": "workspace:^",
    "@eternal-twin/core": "^0.10.3",
    "@eternal-twin/etwin-client-http": "^0.10.3",
    "@eternal-twin/oauth-client-http": "^0.10.3",
    "body-parser": "^1.20.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "cron": "^3.1.6",
    "discord.js": "^14.13.0",
    "express": "^4.18.2",
    "express-jwt": "^8.4.1",
    "express-validator": "^7.0.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "native-dinorpg": "workspace:^*",
    "node-fetch": "^3.3.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.1.13",
    "request": "^2.88.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "toml": "^3.0.0",
    "typeorm": "^0.3.17",
    "url": "^0.11.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/preset-env": "^7.23.3",
    "@types/cheerio": "^0.22.34",
    "@types/cors": "^2.8.16",
    "@types/cron": "^2.4.0",
    "@types/express": "^4.17.21",
    "@types/express-jwt": "^7.4.2",
    "@types/jest": "^29.5.8",
    "@types/multer": "^1.4.10",
    "@types/node": "^20.9.0",
    "@types/node-fetch": "^2.6.9",
    "@types/request": "^2.48.12",
    "@types/swagger-jsdoc": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/validator": "^13.11.6",
    "babel-jest": "^29.7.0",
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "node-html-parser": "^6.1.11",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsc-watch": "^6.0.4",
    "typescript": "^5.2.2"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "files": [
    "./dist/**/*.(js|map|ts)",
    "./src/"
  ]
}
